# Telegram Settings
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_channel_id

# Gemini & AI Settings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY_2=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_PROVIDERS=gemini,groq,groq:openai/gpt-oss-20b,openrouter
AI_REQUEST_DELAY_SECONDS=8
MAX_GEMINI_REQUESTS=10

# Database Settings (Neon PostgreSQL)
# Use this to persist sent news and avoid duplicates across restarts
USE_POSTGRES=true
DATABASE_URL=postgres://user:password@localhost:5432/dknews?sslmode=disable
DATABASE_TTL_HOURS=840

# Cache Settings (File-based fallback)
CACHE_FILE_PATH=sent_news.json
CACHE_TTL_HOURS=48
DUPLICATE_WINDOW_HOURS=24

# App Settings
BOT_MODE=single
PUBLISH_LIMIT=1
SCRAPE_CONCURRENCY=1
DEBUG=false
