# Telegram Settings
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_channel_id

# Gemini AI Settings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDERS=gemini,groq
AI_REQUEST_DELAY_SECONDS=7
MAX_GEMINI_REQUESTS=5

# Database Settings (PostgreSQL)
# Use this if you want to persist sent news and avoid duplicates across restarts
USE_POSTGRES=true
DATABASE_URL=postgres://user:password@localhost:5432/dknews?sslmode=disable
DATABASE_TTL_HOURS=48

# Cache Settings (File-based fallback)
CACHE_TTL_HOURS=48
DUPLICATE_WINDOW_HOURS=24

# App Settings
MAX_NEWS_LIMIT=10
SCRAPE_CONCURRENCY=5
DEBUG=false
